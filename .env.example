# NexusBank Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Core ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# ─── Database ──────────────────────────────────────────
# SQLite (default for dev)
DATABASE_URL=sqlite:///nexusbank.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexusbank

# ─── Mail (Flask-Mail) ─────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=NexusBank <noreply@nexusbank.com>

# ─── Admin Seed ────────────────────────────────────────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@nexusbank.com
ADMIN_PASSWORD=Admin@1234
ADMIN_MPIN=123456

# ─── App Settings ──────────────────────────────────────
APP_NAME=NexusBank
APP_URL=http://127.0.0.1:5000
DEMO_MODE=1
